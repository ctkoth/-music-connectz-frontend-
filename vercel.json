{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/exercise-demos/:file", "destination": "https://ctkoth.github.io/mcz-media/exercise-demos/:file", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://admin.musicconnectz.net/api/:path*" },
    { "source": "/downloads/:version/MusicConnectZ-Setup.exe", "destination": "https://raw.githubusercontent.com/ctkoth/-music-connectz-frontend-/downloads/:version/MusicConnectZ-Setup.exe" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
