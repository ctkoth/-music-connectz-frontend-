# API base — empty = https://admin.musicconnectz.net (direct)
VITE_API_BASE=
VITE_OAUTH_REDIRECT=https://musicconnectz.net/oauth/callback

# OAuth client IDs (public). Buttons show for all; unconfigured ones explain what to set.
# This list must match PROVIDERS in src/auth/OAuthButtons.jsx exactly — a var
# for a provider with no button does nothing, and a provider with no var here
# just falls back to the backend's own /api/auth/oauth-config/ answer.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_SPOTIFY_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_TWITTER_CLIENT_ID=
VITE_SOUNDCLOUD_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
VITE_DISCORD_CLIENT_ID=
VITE_REDDIT_CLIENT_ID=
